# Set these in Vercel -> Project -> Settings -> Environment Variables
# (never commit real values). For local runs with `vercel dev`, copy to .env.local.

# Supabase Postgres connection string (use the pooled/transaction one, port 6543).
# Supabase's Vercel integration adds POSTGRES_URL automatically; the API uses
# DATABASE_URL first, then falls back to POSTGRES_URL.
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# If the password contains special characters, URL-encode them (# -> %23, @ -> %40).

# Password the app asks for in the browser (mark as Sensitive in Vercel)
APP_PASSWORD=
