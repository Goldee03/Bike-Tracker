# --- Database connection ---
# Approach 1 (managed cloud DB, e.g. AWS RDS):
#   DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/<dbname>
#   DATABASE_SSL=true
#
# Approach 2 (Postgres installed natively on the VM, app in Docker):
#   DATABASE_URL=postgres://<user>:<password>@host.docker.internal:5432/<dbname>
#   DATABASE_SSL=false
DATABASE_URL=
DATABASE_SSL=false

PORT=3000
